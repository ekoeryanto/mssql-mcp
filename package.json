{
  "name": "mssql-mcp",
  "version": "1.2.0",
  "description": "Model Context Protocol (MCP) server for Microsoft SQL Server",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && bun build src/index.ts --target=node --outfile=dist/bundle.js",
    "start": "node dist/index.js",
    "test": "echo \"Test suite coming soon\"",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "release": "release-it"
  },
  "keywords": [
    "mcp",
    "sqlserver",
    "model-context-protocol",
    "database"
  ],
  "author": "Eko Eryanto",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.1",
    "eventsource": "^5.1.1",
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/mssql": "^9.1.11",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "prettier": "^3.9.6",
    "release-it": "^21.0.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
