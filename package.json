{
  "name": "mssql-mcp",
  "version": "1.3.0",
  "description": "Model Context Protocol (MCP) server for Microsoft SQL Server",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc && bun build src/index.ts --target=node --outfile=dist/bundle.js",
    "start": "node dist/index.js",
    "test": "bun test",
    "lint": "eslint .",
    "release": "release-it"
  },
  "keywords": [
    "mcp",
    "sqlserver",
    "model-context-protocol",
    "database"
  ],
  "author": "Eko Eryanto",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.17.1",
    "mssql": "^12.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.13.3",
    "eslint": "^10",
    "release-it": "^21.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8"
  }
}
