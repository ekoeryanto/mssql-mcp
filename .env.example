# SQL Server Connection Configuration
SQLSERVER_SERVER=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=master
SQLSERVER_USERNAME=sa
SQLSERVER_PASSWORD=YourStrong@Password
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
SQLSERVER_ALLOW_MUTATIONS=false

# Optional: Connection Pool Settings
SQLSERVER_CONNECTION_POOL_MIN=2
SQLSERVER_CONNECTION_POOL_MAX=10
SQLSERVER_REQUEST_TIMEOUT=30000

# Server Configuration
MCP_SERVER_NAME=mssql-mcp
LOG_LEVEL=info
MCP_SERVER_AUTH_TOKEN=YourSuperSecretToken

# Transport: 'stdio' (default, for local clients) or 'http' (Streamable HTTP, for remote clients)
# MCP_TRANSPORT=stdio
# PORT=3000
